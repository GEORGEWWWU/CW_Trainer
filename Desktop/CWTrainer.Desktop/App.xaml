<Application x:Class="CWTrainer.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <!-- Color palette -->
        <SolidColorBrush x:Key="WindowBg" Color="#0B1020"/>
        <SolidColorBrush x:Key="PanelBg" Color="#141D30"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#26334A"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#EDF3FC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#91A0B8"/>
        <SolidColorBrush x:Key="Accent" Color="#6EA8FE"/>

        <SolidColorBrush x:Key="InputBg" Color="#18243A"/>
        <SolidColorBrush x:Key="InputBorder" Color="#344865"/>
        <SolidColorBrush x:Key="InputHover" Color="#263B5A"/>
        <SolidColorBrush x:Key="InputSelected" Color="#285EAC"/>

        <!-- Global TextBlock -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI"/>
        </Style>

        <!-- Global Button -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="#F7FAFF"/>
            <Setter Property="Background" Value="#285EAC"/>
            <Setter Property="BorderBrush" Value="#3979D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Dark ComboBox -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#EDF3FC"/>
            <Setter Property="Background" Value="#18243A"/>
            <Setter Property="BorderBrush" Value="#344865"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Foreground" Value="#EDF3FC"/>
                        <Setter Property="Background" Value="#18243A"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>

                        <Style.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#263B5A"/>
                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#285EAC"/>
                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Foreground"
                                        Value="#65748A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
