<Window x:Class="CWTrainer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CW Trainer" Height="780" Width="1120" MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CW TRAINER" FontSize="12" FontWeight="Bold" Foreground="#75AFFF" />
                <TextBlock Text="Morse keyer control" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
                <TextBlock Text="ESP32-S3 · USB CDC · Local audio" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#17243A" BorderBrush="#2A3C58" BorderThickness="1" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#D49B45" Margin="0,0,9,0" />
                    <TextBlock x:Name="ConnectionText" Text="未连接" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Connection bar -->
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="16" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="设备端口" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ComboBox x:Name="PortCombo" Grid.Column="1" />
                <Button x:Name="RefreshButton" Grid.Column="2" Content="刷新端口" Margin="10,0,0,0" Click="RefreshButton_Click" Background="#26364F" BorderBrush="#354A69" />
                <Button x:Name="ConnectButton" Grid.Column="3" Content="连接练习器" Margin="10,0,0,0" Click="ConnectButton_Click" />
                <TextBlock x:Name="DeviceInfoText" Grid.Column="4" Text="连接设备后可切换电脑发声、设置速度和键控模式。" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="18,0,0,0" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <!-- Settings -->
            <StackPanel Grid.Column="0" Margin="0,0,9,0">
                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="声音输出" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="连接成功后，可以完全关闭开发板上的实体蜂鸣器。" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ComboBox x:Name="OutputCombo" SelectionChanged="OutputCombo_SelectionChanged">
                            <ComboBoxItem Content="实体蜂鸣器" Tag="BUZZER" />
                            <ComboBoxItem Content="电脑软件发声" Tag="PC" />
                            <ComboBoxItem Content="实体 + 电脑同时发声" Tag="BOTH" />
                        </ComboBox>
                        <TextBlock Text="选择‘电脑软件发声’后，ESP32 仍负责精确生成点划，电脑只负责播放声音。" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="键控参数" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="发送速度（WPM）" Style="{StaticResource SmallLabel}" />
                                <Slider x:Name="WpmSlider" Minimum="5" Maximum="60" Value="15" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="WpmSlider_ValueChanged" />
                            </StackPanel>
                            <TextBlock x:Name="WpmValueText" Grid.Column="1" Text="15 WPM" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="电键模式" Style="{StaticResource SmallLabel}" />
                        <ComboBox x:Name="ModeCombo" SelectedIndex="2" Margin="0,0,0,14">
                            <ComboBoxItem Content="Straight Key（直键）" Tag="STRAIGHT" />
                            <ComboBoxItem Content="Iambic A（双桨 A）" Tag="IAMBIC_A" />
                            <ComboBoxItem Content="Iambic B（双桨 B）" Tag="IAMBIC_B" />
                        </ComboBox>
                        <Button x:Name="ApplySettingsButton" Content="应用键控设置" Click="ApplySettingsButton_Click" HorizontalAlignment="Stretch" />
                        <TextBlock Text="速度范围：5–60 WPM。修改后点击应用，参数立即发送到开发板。" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="电脑声音" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="音调频率" Style="{StaticResource SmallLabel}" />
                                <Slider x:Name="ToneSlider" Minimum="300" Maximum="1200" Value="650" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="ToneSlider_ValueChanged" />
                            </StackPanel>
                            <TextBlock x:Name="ToneValueText" Grid.Column="1" Text="650 Hz" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="电脑音量" Style="{StaticResource SmallLabel}" />
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="45" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="VolumeSlider_ValueChanged" />
                            </StackPanel>
                            <TextBlock x:Name="VolumeValueText" Grid.Column="1" Text="45%" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                        </Grid>
                        <Button Content="试听电脑音" Click="TestToneButton_Click" Background="#26364F" BorderBrush="#354A69" Margin="0,14,0,0" />
                        <TextBlock Text="音调与音量只影响电脑播放，不会改变有源蜂鸣器本身的音量。" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Live view -->
            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,18" MinHeight="185">
                    <StackPanel>
                        <TextBlock Text="实时电键状态" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="KeyStateText" Text="等待电键输入…" FontSize="24" FontWeight="Bold" Margin="0,10,0,8" />
                        <TextBlock Text="LEFT · DIT（点）    RIGHT · DAH（划）" Foreground="{StaticResource TextMuted}" FontSize="11" />
                        <Border Background="#0C1423" BorderBrush="#26334A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="点划预览" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="PreviewText" Text="等待发送…" FontSize="25" FontFamily="Consolas" Foreground="#8FC1FF" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="清空预览" Click="ClearPreviewButton_Click" Background="#26364F" BorderBrush="#354A69" HorizontalAlignment="Right" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelStyle}" MinHeight="250">
                    <StackPanel>
                        <TextBlock Text="通信事件" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="EventList" Height="270" Background="#0C1423" Foreground="#C8D5E8" BorderBrush="#26334A" FontFamily="Consolas" FontSize="11" Padding="8" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="CW Trainer V2 · Keying and timing stay on ESP32-S3 · PC audio is optional" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </Grid>
</Window>
