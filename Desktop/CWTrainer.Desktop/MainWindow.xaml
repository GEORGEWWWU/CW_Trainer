<Window x:Class="CWTrainer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CW Trainer"
        Icon="Assets/app.ico"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <!--
        无边框窗口默认会留一圈由 DWM 绘制的非客户区（顶部那条白边就是它）。
        用 WindowChrome 把非客户区收掉：CaptionHeight=0 表示自己处理拖动，
        ResizeBorderThickness 保留边缘拖拽缩放。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!--
        整页固定 1200x760 版面，外层 Viewbox 等比缩放：
        任何窗口尺寸都能一次看全，永远不需要页面滚动。
        这也正好对应以后移植到安卓时「一套版面适配所有屏幕」的思路。
    -->
    <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="1200" Height="800" Background="{DynamicResource Surface}">

            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== 顶栏 ==================== -->
            <Grid Grid.Row="0"
                  Margin="32,0,20,0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 与 .ico 一致的点划标 -->
                    <Border Width="26" Height="26"
                            CornerRadius="7.5"
                            Background="{DynamicResource Ink}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Ellipse Width="4.5" Height="4.5"
                                     Fill="{DynamicResource Accent}"
                                     Margin="0,0,3.5,0"/>
                            <Border Width="9" Height="4.5"
                                    CornerRadius="2.25"
                                    Background="{DynamicResource Accent}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="CW Trainer"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"/>

                    <Border Width="1" Height="14"
                            Background="{DynamicResource Hairline}"
                            Margin="14,0"/>

                    <TextBlock Text="摩斯电码练习器"
                               FontSize="11.5"
                               Foreground="{DynamicResource Ink3}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- 设置 -->
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource WindowButton}"
                            Click="SettingsButton_Click"
                            Margin="0,0,6,0"
                            ToolTip="设置"
                            AutomationProperties.Name="设置">
                        <Viewbox Width="19" Height="19">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource IconStroke}"
                                      Data="M4,8 H20 M4,16 H20"/>
                                <Ellipse Canvas.Left="12.2" Canvas.Top="5.2"
                                         Width="5.6" Height="5.6"
                                         Stroke="{DynamicResource Ink2}"
                                         StrokeThickness="1.6"
                                         Fill="Transparent"/>
                                <Ellipse Canvas.Left="6.2" Canvas.Top="13.2"
                                         Width="5.6" Height="5.6"
                                         Stroke="{DynamicResource Ink2}"
                                         StrokeThickness="1.6"
                                         Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- 连接状态 -->
                    <Border Background="{DynamicResource Paper}"
                            CornerRadius="16"
                            Padding="12,7"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionDot"
                                     Width="6" Height="6"
                                     Fill="{DynamicResource Ink3}"
                                     Margin="0,0,7,0"/>
                            <TextBlock x:Name="ConnectionText"
                                       Text="未连接"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Ink2}"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource WindowButton}"
                            Click="MinimizeButton_Click"
                            ToolTip="最小化">
                        <Viewbox Width="14" Height="14">
                            <Path Style="{StaticResource IconStroke}"
                                  Data="M5,12 L19,12"/>
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource WindowButton}"
                            Click="MaximizeButton_Click"
                            ToolTip="最大化">
                        <Viewbox Width="14" Height="14">
                            <Path Style="{StaticResource IconStroke}"
                                  Data="M5.5,5.5 L18.5,5.5 L18.5,18.5 L5.5,18.5 Z"/>
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource WindowButton}"
                            Click="CloseButton_Click"
                            ToolTip="关闭">
                        <Viewbox Width="14" Height="14">
                            <Path Style="{StaticResource IconStroke}"
                                  Data="M6,6 L18,18 M18,6 L6,18"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ==================== 主体 ==================== -->
            <Grid Grid.Row="1" Margin="32,4,32,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="372"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ========== 左列 ========== -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 设备 -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource Paper}"
                            CornerRadius="20"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="设备连接" Style="{StaticResource CardLabel}"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <ComboBox x:Name="PortCombo"/>
                                    <TextBlock Text="选择端口"
                                               Margin="15,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource Ink3}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=PortCombo}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button x:Name="RefreshButton"
                                        Grid.Column="2"
                                        Style="{StaticResource IconButton}"
                                        Click="RefreshButton_Click"
                                        ToolTip="刷新端口">
                                    <Viewbox Width="20" Height="20">
                                        <Path Style="{StaticResource IconStroke}"
                                              Data="M19.5,8.5 A8.5,8.5 0 1 0 21,12 M19.5,4.5 L19.5,8.5 L15.5,8.5"/>
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <Button x:Name="ConnectButton"
                                    Content="连接设备"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,12,0,0"
                                    Click="ConnectButton_Click"/>

                            <TextBlock x:Name="DeviceInfoText"
                                       Text="请选择 ESP32-S3 的 USB OTG 端口。"
                                       Style="{StaticResource Hint}"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 声音输出 -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource Paper}"
                            CornerRadius="20"
                            Padding="20">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="声音输出" Style="{StaticResource CardLabel}"
                                           VerticalAlignment="Center"/>
                                <Button Content="试听"
                                        Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Right"
                                        Margin="0,-7,-8,0"
                                        Click="TestToneButton_Click"/>
                            </Grid>

                            <Border Style="{StaticResource SegmentBar}" Margin="0,10,0,0">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="OutputBuzzerRadio"
                                                 Content="实体"
                                                 Tag="BUZZER"
                                                 GroupName="Output"
                                                 Style="{StaticResource SegmentRadio}"
                                                 IsChecked="True"
                                                 Checked="OutputSegment_Checked"/>
                                    <RadioButton x:Name="OutputPcRadio"
                                                 Content="电脑"
                                                 Tag="PC"
                                                 GroupName="Output"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Checked="OutputSegment_Checked"/>
                                    <RadioButton x:Name="OutputBothRadio"
                                                 Content="双路"
                                                 Tag="BOTH"
                                                 GroupName="Output"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Checked="OutputSegment_Checked"/>
                                </UniformGrid>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="输出设备"
                                           Style="{StaticResource CardLabel}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <ComboBox x:Name="AudioDeviceCombo"
                                          Grid.Column="1"
                                          Height="38"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="AudioDeviceCombo_SelectionChanged"/>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <TextBlock Text="音调" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="ToneValueText"
                                           Text="650 Hz"
                                           Style="{StaticResource CardValue}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Slider x:Name="ToneSlider"
                                    Minimum="300" Maximum="1200"
                                    Value="650"
                                    TickFrequency="50"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,2,0,0"
                                    ValueChanged="ToneSlider_ValueChanged"/>

                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="音量" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="VolumeValueText"
                                           Text="45%"
                                           Style="{StaticResource CardValue}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Slider x:Name="VolumeSlider"
                                    Minimum="0" Maximum="100"
                                    Value="45"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,2,0,0"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 键控 -->
                    <Border Grid.Row="4"
                            Background="{DynamicResource Paper}"
                            CornerRadius="20"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="发送速度" Style="{StaticResource CardLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="WpmValueText"
                                           Text="15 WPM"
                                           Style="{StaticResource Metric}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Slider x:Name="WpmSlider"
                                    Grid.Row="1"
                                    Minimum="5" Maximum="60"
                                    Value="15"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,2,0,0"
                                    ValueChanged="WpmSlider_ValueChanged"/>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <TextBlock Text="键控模式"
                                           Style="{StaticResource CardLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="KeyTimingText"
                                           Text="点 80 · 划 240 ms"
                                           Style="{StaticResource Hint}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Row="3" VerticalAlignment="Top">
                            <Border Style="{StaticResource SegmentBar}"
                                    Margin="0,8,0,0">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="ModeStraightRadio"
                                                 Content="直键"
                                                 Tag="STRAIGHT"
                                                 GroupName="Mode"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Checked="ModeSegment_Checked"/>
                                    <RadioButton x:Name="ModeIambicARadio"
                                                 Content="Iambic A"
                                                 Tag="IAMBIC_A"
                                                 GroupName="Mode"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Checked="ModeSegment_Checked"/>
                                    <RadioButton x:Name="ModeIambicBRadio"
                                                 Content="Iambic B"
                                                 Tag="IAMBIC_B"
                                                 GroupName="Mode"
                                                 Style="{StaticResource SegmentRadio}"
                                                 IsChecked="True"
                                                 Checked="ModeSegment_Checked"/>
                                </UniformGrid>
                            </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========== 右列 ========== -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="196"/>
                    </Grid.RowDefinitions>

                    <!-- 实时抄收 -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource Paper}"
                            CornerRadius="20"
                            Padding="24,20,24,22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="实时抄收"
                                           Style="{StaticResource CardLabel}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="电码表"
                                            Style="{StaticResource GhostButton}"
                                            Margin="0,-7,4,0"
                                            Click="DictionaryButton_Click"/>
                                    <Button Content="复制"
                                            Style="{StaticResource GhostButton}"
                                            Margin="0,-7,4,0"
                                            Click="CopyTextButton_Click">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                                        <Path Style="{StaticResource IconStroke}"
                                                              Data="M9.5,9.5 L19,9.5 L19,19 L9.5,19 Z M5,14.5 L5,5 L14.5,5"/>
                                                    </Viewbox>
                                                    <TextBlock Text="复制" FontSize="12.5"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                    <Button Content="清空"
                                            Style="{StaticResource GhostButton}"
                                            Margin="0,-7,-8,0"
                                            Click="ClearPreviewButton_Click">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                                        <Path Style="{StaticResource IconStroke}"
                                                              Data="M4.5,7 L19.5,7 M9.5,4.5 L14.5,4.5 M6.5,7 L7.5,19.5 L16.5,19.5 L17.5,7"/>
                                                    </Viewbox>
                                                    <TextBlock Text="清空" FontSize="12.5"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 解码文本 -->
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <StackPanel x:Name="EmptyHint"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,14">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{DynamicResource Hairline}"
                                                 Margin="0,0,7,0"/>
                                        <Border Width="18" Height="8"
                                                CornerRadius="4"
                                                Background="{DynamicResource Hairline}"/>
                                    </StackPanel>
                                    <TextBlock Text="等待接收摩斯码"
                                               FontSize="15"
                                               Foreground="{DynamicResource Ink3}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Name="DecodedText"
                                           Text=""
                                           FontSize="42"
                                           FontWeight="SemiBold"
                                           LineHeight="52"
                                           Foreground="{DynamicResource Ink}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 当前点划 + 电键状态 -->
                            <StackPanel Grid.Row="2">
                                <Border Height="1"
                                        Background="{DynamicResource Hairline}"
                                        Margin="0,0,0,14"/>

                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="PreviewText"
                                               Text=""
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Ink3}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Ellipse x:Name="KeyDot"
                                                 Width="7" Height="7"
                                                 Fill="{DynamicResource Ink3}"
                                                 Margin="0,0,7,0"/>
                                        <TextBlock x:Name="KeyStateText"
                                                   Text="空闲"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Ink2}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 通信记录 -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource Paper}"
                            CornerRadius="20"
                            Padding="20,18,20,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="通信记录"
                                       Style="{StaticResource CardLabel}"/>

                            <ListBox x:Name="EventList"
                                     Grid.Row="1"
                                     Margin="0,8,0,0"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="11.5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========== 设置浮层 ========== -->
            <Border x:Name="SettingsOverlay"
                    Grid.Row="0" Grid.RowSpan="2"
                    Background="{DynamicResource Scrim}"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="SettingsOverlay_MouseDown">

                <Border Width="520"
                        Background="{DynamicResource Paper}"
                        CornerRadius="20"
                        Padding="28,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.18"
                                          BlurRadius="40" ShadowDepth="8"
                                          Direction="270"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="偏好会被记住，下次启动直接生效"
                                           Style="{StaticResource Hint}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <Button Content="关闭"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-8,-8,0"
                                    Click="SettingsClose_Click"/>
                        </Grid>

                        <TextBlock Text="外观" Style="{StaticResource CardLabel}" Margin="0,28,0,0"/>

                        <Border Style="{StaticResource SegmentBar}" Margin="0,10,0,0">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="ThemeSystemRadio"
                                             Content="跟随系统"
                                             Tag="System"
                                             GroupName="Theme"
                                             Style="{StaticResource SegmentRadio}"
                                             Checked="ThemeSegment_Checked"/>
                                <RadioButton x:Name="ThemeLightRadio"
                                             Content="浅色"
                                             Tag="Light"
                                             GroupName="Theme"
                                             Style="{StaticResource SegmentRadio}"
                                             Checked="ThemeSegment_Checked"/>
                                <RadioButton x:Name="ThemeDarkRadio"
                                             Content="深色"
                                             Tag="Dark"
                                             GroupName="Theme"
                                             Style="{StaticResource SegmentRadio}"
                                             Checked="ThemeSegment_Checked"/>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="选「跟随系统」时，会随 Windows 的「应用模式」自动切换。"
                                   Style="{StaticResource Hint}"
                                   Margin="0,10,0,0"/>

                        <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,24,0,20"/>

                        <Grid>
                            <TextBlock Text="CW TRAINER" Style="{StaticResource CardLabel}"/>
                            <TextBlock x:Name="AboutVersionText"
                                       Text=""
                                       Style="{StaticResource Hint}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="ESP32-S3 双桨电键 + Windows 桌面端。点划时序由设备生成，电脑负责发声与抄收。"
                                   Style="{StaticResource Hint}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ========== 电码表浮层 ========== -->
            <Border x:Name="DictionaryOverlay"
                    Grid.Row="0" Grid.RowSpan="2"
                    Background="{DynamicResource Scrim}"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="DictionaryOverlay_MouseDown">

                <Border Width="1000"
                        Background="{DynamicResource Paper}"
                        CornerRadius="20"
                        Padding="28,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.18"
                                          BlurRadius="40" ShadowDepth="8"
                                          Direction="270"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="摩斯电码表"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="点任意一行，用当前速度和音调听一遍"
                                           Style="{StaticResource Hint}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <Button Content="关闭"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-8,-8,0"
                                    Click="DictionaryClose_Click"/>
                        </Grid>

                        <ItemsControl x:Name="DictionaryList" Grid.Row="1" Margin="-10,0,-8,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DictItem}"
                                            Tag="{Binding Code}"
                                            Click="DictionaryItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding SymbolText}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CodeText}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource Accent}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Viewbox>
    </Border>
</Window>
