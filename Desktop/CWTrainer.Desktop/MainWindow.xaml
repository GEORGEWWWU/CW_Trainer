<Window x:Class="CWTrainer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CW Trainer"
        Width="1160" Height="820"
        MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Background="{StaticResource WindowBg}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="17,0,0,0">
                    <Border Width="8" Height="8"
                            CornerRadius="4"
                            Background="{StaticResource Accent}"
                            VerticalAlignment="Center"
                            Margin="0,0,9,0"/>
                    <TextBlock Text="CW Trainer"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="—"
                        Style="{StaticResource TitleBarButton}"
                        Click="MinimizeButton_Click"/>

                <Button Grid.Column="2"
                        Content="×"
                        Style="{StaticResource TitleBarButton}"
                        Click="CloseButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="30,24,30,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 页面标题 -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="MORSE / KEYER"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Accent}"
                                       />

                            <TextBlock Text="CW Trainer"
                                       FontSize="34"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,5,0,2"/>

                            <TextBlock Text="摩斯电码练习 · 双桨电键 · 实时抄收"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource PanelBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="15,10"
                                VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectionDot"
                                         Width="8" Height="8"
                                         Fill="#B89869"
                                         Margin="0,0,9,0"/>

                                <TextBlock x:Name="ConnectionText"
                                           Text="尚未连接"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 连接区域 -->
                    <Border Grid.Row="1"
                            Style="{StaticResource PanelStyle}"
                            Margin="0,0,0,18">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center"
                                        Margin="0,0,18,0">
                                <TextBlock Text="DEVICE"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Accent}"/>
                                <TextBlock Text="USB OTG"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <ComboBox x:Name="PortCombo"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"/>

                            <Button x:Name="RefreshButton"
                                    Grid.Column="2"
                                    Content="刷新"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0"
                                    Click="RefreshButton_Click"/>

                            <Button x:Name="ConnectButton"
                                    Grid.Column="3"
                                    Content="连接设备"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="9,0,0,0"
                                    Click="ConnectButton_Click"/>

                            <TextBlock x:Name="DeviceInfoText"
                                       Grid.Column="4"
                                       Text="请选择 ESP32-S3 的 OTG COM 端口。"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       TextWrapping="Wrap"
                                       Margin="18,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 主内容 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.92*"/>
                            <ColumnDefinition Width="1.08*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧设置 -->
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,9,0">

                            <Border Style="{StaticResource PanelStyle}"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="声音输出"
                                               Style="{StaticResource SectionTitle}"/>

                                    <TextBlock Text="选择声音从哪里播放"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,14"/>

                                    <ComboBox x:Name="OutputCombo"
                                              SelectionChanged="OutputCombo_SelectionChanged">
                                        <ComboBoxItem Content="实体蜂鸣器"
                                                      Tag="BUZZER"/>
                                        <ComboBoxItem Content="电脑扬声器"
                                                      Tag="PC"/>
                                        <ComboBoxItem Content="实体 + 电脑"
                                                      Tag="BOTH"/>
                                    </ComboBox>

                                    <TextBlock Text="电脑模式下，由电脑播放电键音；ESP32 负责点划时序。"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelStyle}"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="KEYING"
                                               Style="{StaticResource SectionTitle}"/>

                                    <TextBlock Text="键控参数"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,18"/>

                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="85"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="发送速度"
                                                       Style="{StaticResource SmallLabel}"/>
                                            <Slider x:Name="WpmSlider"
                                                    Minimum="5" Maximum="60"
                                                    Value="15"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="WpmSlider_ValueChanged"/>
                                        </StackPanel>

                                        <TextBlock x:Name="WpmValueText"
                                                   Grid.Column="1"
                                                   Text="15 WPM"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="电键模式"
                                               Style="{StaticResource SmallLabel}"/>

                                    <ComboBox x:Name="ModeCombo"
                                              SelectedIndex="2"
                                              Margin="0,0,0,15">
                                        <ComboBoxItem Content="直键"
                                                      Tag="STRAIGHT"/>
                                        <ComboBoxItem Content="双桨 · Iambic A"
                                                      Tag="IAMBIC_A"/>
                                        <ComboBoxItem Content="双桨 · Iambic B"
                                                      Tag="IAMBIC_B"/>
                                    </ComboBox>

                                    <Button x:Name="ApplySettingsButton"
                                            Content="应用设置"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="ApplySettingsButton_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="PC AUDIO"
                                               Style="{StaticResource SectionTitle}"/>

                                    <TextBlock Text="电脑声音"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,18"/>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="75"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="音调频率"
                                                       Style="{StaticResource SmallLabel}"/>
                                            <Slider x:Name="ToneSlider"
                                                    Minimum="300" Maximum="1200"
                                                    Value="650"
                                                    TickFrequency="50"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="ToneSlider_ValueChanged"/>
                                        </StackPanel>

                                        <TextBlock x:Name="ToneValueText"
                                                   Grid.Column="1"
                                                   Text="650 Hz"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="75"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="音量"
                                                       Style="{StaticResource SmallLabel}"/>
                                            <Slider x:Name="VolumeSlider"
                                                    Minimum="0" Maximum="100"
                                                    Value="45"
                                                    TickFrequency="5"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="VolumeSlider_ValueChanged"/>
                                        </StackPanel>

                                        <TextBlock x:Name="VolumeValueText"
                                                   Grid.Column="1"
                                                   Text="45%"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <Button Content="试听"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,16,0,0"
                                            Click="TestToneButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 右侧实时抄收 -->
                        <StackPanel Grid.Column="1"
                                    Margin="9,0,0,0">

                            <Border Style="{StaticResource PanelStyle}"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="LIVE DECODER"
                                               Style="{StaticResource SectionTitle}"/>

                                    <TextBlock Text="实时抄收"
                                               FontSize="23"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,18"/>

                                    <Border Background="{StaticResource PaperBg}"
                                            BorderBrush="{StaticResource PanelBorder}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="18"
                                            MinHeight="160">

                                        <StackPanel>
                                            <TextBlock Text="DECODED TEXT"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextMuted}"
                                                       />

                                            <TextBlock x:Name="DecodedText"
                                                       Text=""
                                                       FontSize="27"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,13,0,0"
                                                       MinHeight="65"/>

                                            <TextBlock Text="等待接收摩斯码……"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMuted}"
                                                       Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="DOT / DASH"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMuted}"
                                               
                                               Margin="0,18,0,8"/>

                                    <Border Background="{StaticResource SurfaceBg}"
                                            CornerRadius="10"
                                            Padding="14">
                                        <TextBlock x:Name="PreviewText"
                                                   Text="等待输入"
                                                   FontSize="23"
                                                   FontFamily="Consolas"
                                                   Foreground="{StaticResource Accent}"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Text="当前电键状态"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               Margin="0,18,0,6"/>

                                    <TextBlock x:Name="KeyStateText"
                                               Text="等待输入"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Content="复制抄收文本"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,5,0"
                                                Click="CopyTextButton_Click"/>

                                        <Button Grid.Column="1"
                                                Content="清空内容"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="5,0,0,0"
                                                Click="ClearPreviewButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="ACTIVITY"
                                               Style="{StaticResource SectionTitle}"/>

                                    <TextBlock Text="通信记录"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12"/>

                                    <ListBox x:Name="EventList"
                                             Height="190"
                                             Background="{StaticResource PaperBg}"
                                             Foreground="{StaticResource TextSecondary}"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="10"
                                             Padding="9"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Text="CW TRAINER  ·  MADE FOR MORSE"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="9"
                               
                               HorizontalAlignment="Center"
                               Margin="0,22,0,0"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>